@model IEnumerable<DemoMVC.Models.Entities.ThietBi>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group" style="width: 400px;">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" 
               class="form-control" placeholder="Nhập tên thiết bị hoặc loại..." />
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    </div>
</form>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TenTB)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SoLuongTon)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Gia)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LoaiThietBi)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TenTB)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SoLuongTon)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Gia)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LoaiThietBi.TenLoai)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaTB">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaTB">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaTB">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
